        "data = pd.concat([x, x.shift(1), x.shift(2), x.shift(3)], axis=1).dropna()\n",
        "data.columns = [\"x\", \"xL1\", \"xL2\", \"xL3\"]\n",
        "\n",
        "fit = ols(\"x ~ 0+xL1+xL2+xL3\", data=data).fit()\n",
        "print(f\"MSE de los residuos: {fit.mse_resid}\")\n",
        "fit.summary()"
      ]
