        "#Usamos la función de statsmodels para ajustar.\n",
        "#trend=\"c\" nos permite incorporar una tendencia constante (media) al fit.\n",
        "from statsmodels.tsa.api import ARIMA\n",
        "fit = ARIMA(rec,order=(2,0,0), trend=\"c\").fit()\n",
        "print(fit.mse)\n",
        "fit.summary()"
      ]
