    "plot_acf(x,bartlett_confint=False, label=\"Empirica\");\n",
    "plt.scatter(range(0,26),np.concatenate(([1],[theta/(1+theta**2)], np.zeros(24))), label=\"Teorica\");\n",
    "plt.legend();"
   ]
