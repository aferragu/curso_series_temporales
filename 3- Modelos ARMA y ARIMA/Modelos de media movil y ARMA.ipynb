    "#Los parámetros son:\n",
    "# order = (p,d,q), donde q es la parte de media mobil.\n",
    "# trend = \"n\" indica que la serie ya estaba centrada.\n",
    "fit = ARIMA(x,order=(0,0,1), trend=\"n\").fit()\n",
    "fit.summary()"
