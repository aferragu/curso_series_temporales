      "source": [
        "## Ejemplo: simulo un MA(1) con theta = 0.5 y hago varios fits\n",
        "theta=0.5\n",
        "x=arma_generate_sample([1],[1,theta],1000)\n",
        "x=pd.Series(x)\n",
        "x.plot(title=f\"Media móvil de orden 1, coeficientes [1,{theta}]\");"
      ]
