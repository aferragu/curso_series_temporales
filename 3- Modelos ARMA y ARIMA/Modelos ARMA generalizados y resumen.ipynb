     "output_type": "execute_result"
    }
   ],
   "source": [
    "##Ajusto directo un ARIMA a la serie x usando statsplots\n",
    "## el parámetro trend=\"t\" permite que la serie diferenciada conserve el drift \n",
    "## la media del resultado de diferenciar\n",
    "from statsmodels.tsa.api import ARIMA\n",
    "\n",
    "fit = ARIMA(x,order=(1,1,0), trend=\"t\").fit()\n",
    "fit.summary()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "slideshow": {
     "slide_type": "slide"
    }
   },
   "source": [
    "Analicemos los residuos del ajuste:"
   ]
  },
  {
   "cell_type": "code",
