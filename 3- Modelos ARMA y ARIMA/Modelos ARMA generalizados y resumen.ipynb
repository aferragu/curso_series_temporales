      "source": [
        "##Ajusto directo un ARIMA a la serie x usando statsplots\n",
        "## el parámetro trend=\"t\" permite que la serie diferenciada conserve el drift\n",
        "## la media del resultado de diferenciar\n",
        "from statsmodels.tsa.api import ARIMA\n",
        "\n",
        "fit = ARIMA(x,order=(1,1,0), trend=\"t\").fit()\n",
        "fit.summary()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "PJlKgzXTHD1v"
      },
      "source": [
        "Analicemos los residuos del ajuste:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Xh6DcNUFHD1v",
        "outputId": "cfb8fc67-e4a9-49c8-9ed7-1c85eec57f15"
      },
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 1500x500 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "res = fit.resid.iloc[1:] #saco el primer residuo porque no tiene sentido luego de diferenciar\n",
        "res.plot();"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Lp66Bt-3HD1v",
        "outputId": "42785c7e-9c00-4785-eb8d-c0cfb2a65fbe"
