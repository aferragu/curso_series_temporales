      "source": [
        "## Simulación de un paseo al azar con deriva\n",
        "delta = 0.1\n",
        "w = np.random.normal(loc=0,scale=1,size=2000)\n",
        "x = np.cumsum(w+delta)\n",
        "x = pd.Series(x)\n",
        "x.plot()\n",
        "plt.title(f\"Paseo al azar con deriva δ = {delta} y varianza del ruido unitaria\");"
      ]
