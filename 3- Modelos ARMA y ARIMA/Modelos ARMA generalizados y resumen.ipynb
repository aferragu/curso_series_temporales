    "#Usamos el modelo ajustado para predecir a futuro\n",
    "h = 24 #horizonte de predicción\n",
    "predicciones = fit.get_prediction(start=birth.size,end=birth.size+h)\n",
    "xhat = predicciones.predicted_mean\n",
