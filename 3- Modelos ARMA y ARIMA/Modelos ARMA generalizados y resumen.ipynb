    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "#Usamos el modelo ajustado para predecir sobre los datos de test usando los 3 modelos:\n",
    "fit1 = fit1.append(x_test)\n",
    "fit2 = fit2.append(x_test)\n",
    "fit3 = fit3.append(x_test)\n",
    "\n",
    "predicciones1 = fit1.get_prediction(start=x_test.index[0],end=x_test.index[-1])\n",
    "predicciones2 = fit2.get_prediction(start=x_test.index[0],end=x_test.index[-1])\n",
    "predicciones3 = fit3.get_prediction(start=x_test.index[0],end=x_test.index[-1])\n",
    "\n",
    "xhat1 = predicciones1.predicted_mean\n",
    "confint1 = predicciones1.conf_int(alpha=0.05) #alpha es la confianza del intervalo\n",
    "xhat2 = predicciones2.predicted_mean\n",
    "confint2 = predicciones2.conf_int(alpha=0.05) #alpha es la confianza del intervalo\n",
    "xhat3 = predicciones3.predicted_mean\n",
    "confint3 = predicciones3.conf_int(alpha=0.05) #alpha es la confianza del intervalo"
   ]
  },
