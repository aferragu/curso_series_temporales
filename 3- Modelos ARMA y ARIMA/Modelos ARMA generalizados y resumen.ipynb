      ],
      "source": [
        "plot_acf(res, bartlett_confint=False);"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "-Gy0M3H_HD1w",
        "outputId": "563e1f17-a807-480d-b539-f35e93ce637f"
