   ],
   "source": [
    "#esto se construye con el comando \"filter\" de R\n",
    "x = lfilter([1],[1,-.9], w)\n",
    "plt.plot(x);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {
    "slideshow": {
