      },
      "source": [
        "Podemos ver además que los residuos siguen una distribución gaussiana:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 29,
      "metadata": {
        "id": "cwSMfSMfcbgE",
        "outputId": "b276c0c2-ac3c-49a3-b671-a57414c07153",
