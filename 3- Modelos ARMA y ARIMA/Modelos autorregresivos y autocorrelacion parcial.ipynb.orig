      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.scatter(r1,r2);\n",
    "plt.title(f\"Correlación remanente: {np.corrcoef(r1,r2)[0,1]}\");"
   ]
  },
