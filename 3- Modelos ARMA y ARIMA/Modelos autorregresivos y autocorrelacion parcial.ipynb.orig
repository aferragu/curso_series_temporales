    {
      "cell_type": "code",
      "execution_count": 43,
      "metadata": {
        "id": "e-YrRU27cbgK",
        "outputId": "c14245c6-ae68-4fb6-ac5a-3c801fe564ce",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 528
        }
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1500x500 with 1 Axes>"
